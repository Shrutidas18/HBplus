# Copy to `.env` and fill in. Never commit `.env`.
#
# ---------- CLIENT (bundled into the app; safe to be public) ----------
# Variables must start with EXPO_PUBLIC_.

# Allowed email domain(s), comma separated. Use your own domain while testing.
EXPO_PUBLIC_ALLOWED_DOMAIN=hbplus.fit

# Firebase console -> Project settings -> Your apps -> Web app -> SDK config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Mobile only: OAuth client IDs from Google Cloud Console -> Credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Mobile only: full URL of the deployed site so the app can reach /api/*.
# Leave empty for the web build (same origin).
EXPO_PUBLIC_API_BASE_URL=

# Dev convenience ONLY. Leave unset in production.
# EXPO_PUBLIC_REQUIRE_API=false


# ---------- SERVER (Netlify Functions; keep secret) ----------
# Set these in Netlify -> Site configuration -> Environment variables,
# and in `.env` only if you run `netlify dev` locally.

# Must match EXPO_PUBLIC_ALLOWED_DOMAIN
ALLOWED_DOMAIN=hbplus.fit

# Comma separated emails that get the "admin" role on sign-in
ADMIN_EMAILS=

# Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key on ONE line, keeping the \n sequences, inside quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
